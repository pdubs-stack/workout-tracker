# The passcode that unlocks the app. Set this to a long, random value.
# Whatever you set here IS the passcode you'll type on the login screen.
AUTH_SECRET=choose-a-long-random-passphrase

# Provided automatically by Vercel once you add the Blob storage integration
# to this project (Vercel dashboard -> Storage -> Create -> Blob -> Connect).
# You do not need to set this by hand on Vercel; only needed for local dev
# if you connect a local .env.local to your Vercel Blob store via `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
